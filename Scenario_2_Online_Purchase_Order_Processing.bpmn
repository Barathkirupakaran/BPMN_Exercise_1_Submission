<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di_1="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://example.com/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_1" name="Online Purchase Order Processing" isExecutable="false">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="order" name="Customer Places Order">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="avail" name="Check Product Availability">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Product Available?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="pay" name="Process Payment">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Payment Successful?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="confirm" name="Confirm Order">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="prepare" name="Prepare Product for Shipment">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ship" name="Ship Order">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="shipconf" name="Shipping Confirmation">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endS" name="Completed">
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="out" name="Notify Customer: Product Out of Stock">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endO" name="Out of Stock">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="fail" name="Notify Customer: Payment Failure">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endF" name="Payment Failed">
      <bpmn:incoming>f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" name="" sourceRef="start" targetRef="order" />
    <bpmn:sequenceFlow id="f2" name="" sourceRef="order" targetRef="avail" />
    <bpmn:sequenceFlow id="f3" name="" sourceRef="avail" targetRef="g1" />
    <bpmn:sequenceFlow id="f4" name="Yes" sourceRef="g1" targetRef="pay" />
    <bpmn:sequenceFlow id="f5" name="No" sourceRef="g1" targetRef="out" />
    <bpmn:sequenceFlow id="f6" name="" sourceRef="out" targetRef="endO" />
    <bpmn:sequenceFlow id="f7" name="" sourceRef="pay" targetRef="g2" />
    <bpmn:sequenceFlow id="f8" name="Yes" sourceRef="g2" targetRef="confirm" />
    <bpmn:sequenceFlow id="f9" name="No" sourceRef="g2" targetRef="fail" />
    <bpmn:sequenceFlow id="f10" name="" sourceRef="fail" targetRef="endF" />
    <bpmn:sequenceFlow id="f11" name="" sourceRef="confirm" targetRef="prepare" />
    <bpmn:sequenceFlow id="f12" name="" sourceRef="prepare" targetRef="ship" />
    <bpmn:sequenceFlow id="f13" name="" sourceRef="ship" targetRef="shipconf" />
    <bpmn:sequenceFlow id="f14" name="" sourceRef="shipconf" targetRef="endS" />
  </bpmn:process>
  <di:BPMNDiagram id="BPMNDiagram_1">
    <di:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <di:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="160" y="180" width="36" height="36" />
