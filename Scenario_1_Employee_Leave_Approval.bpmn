<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di_1="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://example.com/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_1" name="Employee Leave Approval" isExecutable="false">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="submit" name="Submit Leave Request">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="check" name="Check Leave Balance">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Balance Available?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="mgr" name="Send Request to Manager">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Manager Approves?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="update" name="Update Leave Balance">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="approve" name="Send Approval Notification">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endA" name="Approved">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="insuff" name="Send Insufficient-Balance Notification">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endI" name="Insufficient Balance">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="reject" name="Send Rejection Notification">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endR" name="Rejected">
      <bpmn:incoming>f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" name="" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="f2" name="" sourceRef="submit" targetRef="check" />
    <bpmn:sequenceFlow id="f3" name="" sourceRef="check" targetRef="g1" />
    <bpmn:sequenceFlow id="f4" name="Yes" sourceRef="g1" targetRef="mgr" />
    <bpmn:sequenceFlow id="f5" name="No" sourceRef="g1" targetRef="insuff" />
    <bpmn:sequenceFlow id="f6" name="" sourceRef="insuff" targetRef="endI" />
    <bpmn:sequenceFlow id="f7" name="" sourceRef="mgr" targetRef="g2" />
    <bpmn:sequenceFlow id="f8" name="Yes" sourceRef="g2" targetRef="update" />
    <bpmn:sequenceFlow id="f9" name="No" sourceRef="g2" targetRef="reject" />
    <bpmn:sequenceFlow id="f10" name="" sourceRef="update" targetRef="approve" />
    <bpmn:sequenceFlow id="f11" name="" sourceRef="approve" targetRef="endA" />
    <bpmn:sequenceFlow id="f12" name="" sourceRef="reject" targetRef="endR" />
  </bpmn:process>
  <di:BPMNDiagram id="BPMNDiagram_1">
    <di:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <di:BPMNShape id="start_di" bpmnElement="start">
