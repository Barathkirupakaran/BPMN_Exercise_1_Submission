<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di_1="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://example.com/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_1" name="IT Service Request" isExecutable="false">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="submit" name="Submit IT Support Request">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="reg" name="Register Request">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="sev" name="Check Problem Severity">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Problem Severity?">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="low" name="Assign to Support Technician">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="high" name="Assign to Senior Technician">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="invest" name="Investigate Problem">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Can Resolve Internally?">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="fix" name="Fix Problem">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="esc" name="Escalate to External Service Provider">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="upd" name="Update Request Status">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="notif" name="Send Resolution Notification">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="End">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" name="" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="f2" name="" sourceRef="submit" targetRef="reg" />
    <bpmn:sequenceFlow id="f3" name="" sourceRef="reg" targetRef="sev" />
    <bpmn:sequenceFlow id="f4" name="" sourceRef="sev" targetRef="g1" />
    <bpmn:sequenceFlow id="f5" name="Low" sourceRef="g1" targetRef="low" />
    <bpmn:sequenceFlow id="f6" name="High" sourceRef="g1" targetRef="high" />
    <bpmn:sequenceFlow id="f7" name="" sourceRef="low" targetRef="invest" />
    <bpmn:sequenceFlow id="f8" name="" sourceRef="high" targetRef="invest" />
    <bpmn:sequenceFlow id="f9" name="" sourceRef="invest" targetRef="g2" />
    <bpmn:sequenceFlow id="f10" name="Yes" sourceRef="g2" targetRef="fix" />
    <bpmn:sequenceFlow id="f11" name="No" sourceRef="g2" targetRef="esc" />
    <bpmn:sequenceFlow id="f12" name="" sourceRef="fix" targetRef="upd" />
    <bpmn:sequenceFlow id="f13" name="" sourceRef="esc" targetRef="upd" />
    <bpmn:sequenceFlow id="f14" name="" sourceRef="upd" targetRef="notif" />
    <bpmn:sequenceFlow id="f15" name="" sourceRef="notif" targetRef="end" />
  </bpmn:process>
